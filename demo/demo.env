# Compose env file applied after upstream's .env (spike §1, C2).
# Upstream's .env says DEMO_VERSION=latest and IMAGE_VERSION=3.0.0; both are pinned here.
DEMO_VERSION=3.1.0
IMAGE_VERSION=3.1.0

# Lab collector overrides (path relative to demo/.upstream, the compose project directory).
OTEL_COLLECTOR_CONFIG_EXTRAS=../config/otelcol-config-extras.yml
