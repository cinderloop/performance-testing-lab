{
  "name": "perflab-k6",
  "private": true,
  "description": "k6 scripts and their tooling for the performance testing lab",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "25.6.1"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tests/k6",
    "test": "node --test 'tests/k6/**/*.test.ts'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/k6": "2.3.1",
    "@types/node": "25.9.9",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
